# SAATHCHALO Environment Configuration

# Supabase (Optional for cloud sync; embedded engine active by default)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key

# Google Maps Platform (Required for live traffic & traffic-aware routing)
# Required APIs to enable in Google Cloud Console:
# 1. Maps JavaScript API (for interactive map and TrafficLayer)
# 2. Routes API / Directions API (for traffic-aware route ETA)
# 3. Places API (for location autocomplete/search)
VITE_GOOGLE_MAPS_API_KEY=
